# Copie ce fichier en .env.local puis remplis avec tes valeurs Supabase
# (Project Settings → API dans ton dashboard Supabase)
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
# Clé secrète « service_role » : utilisée uniquement côté serveur, ne jamais la préfixer NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=ta_cle_service_role
